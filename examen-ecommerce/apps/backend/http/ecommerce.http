### Variables
@host = http://localhost:8080
@api = {{host}}/api/v1

### ---------- Categorías ----------
GET {{api}}/categories

###
GET {{api}}/categories/1

###
POST {{api}}/categories
Content-Type: application/json

{"name": "Oficina", "discountPct": 5.00}

###
PUT {{api}}/categories/2
Content-Type: application/json

{"name": "Hogar", "discountPct": 0.00}

### 409: tiene productos
DELETE {{api}}/categories/1

### ---------- Productos (HU1) ----------
GET {{api}}/products?categoryId=1&page=0&size=10&sort=unitPrice,desc

###
GET {{api}}/products?name=libro

###
GET {{api}}/products/5

###
POST {{api}}/products
Content-Type: application/json

{"name": "Webcam HD", "unitPrice": 35.00, "categoryId": 1, "stock": 5}

### 400: precio 0
POST {{api}}/products
Content-Type: application/json

{"name": "Gratis", "unitPrice": 0, "categoryId": 1, "stock": 1}

### 409: tiene ventas
DELETE {{api}}/products/2

### ---------- Cupones ----------
GET {{api}}/coupons

###
GET {{api}}/coupons/WELCOME2026

###
POST {{api}}/coupons
Content-Type: application/json

{"code": "BLACKFRIDAY", "discountPct": 20.00, "validFrom": "2026-11-27T00:00:00", "validUntil": "2026-11-30T23:59:59", "active": true}

### 409: fue usado
DELETE {{api}}/coupons/1

### ---------- Carrito (HU2 / HU4) ----------
### (a) 50.00 → 48.00
POST {{api}}/cart/quote
Content-Type: application/json

{"items": [{"productId": 8, "quantity": 2}, {"productId": 2, "quantity": 1}]}

### (b) 110.00 → 96.90
POST {{api}}/cart/quote
Content-Type: application/json

{"items": [{"productId": 3, "quantity": 1}, {"productId": 6, "quantity": 1}]}

### (c) 130.00 → 97.71
POST {{api}}/cart/quote
Content-Type: application/json

{"items": [{"productId": 1, "quantity": 2}, {"productId": 9, "quantity": 1}], "couponCode": "WELCOME2026"}

### (d) 320.00 → 208.00 + mensaje HU4
POST {{api}}/cart/quote
Content-Type: application/json

{"items": [{"productId": 4, "quantity": 1}, {"productId": 12, "quantity": 1}, {"productId": 10, "quantity": 2}], "couponCode": "TESTCAP30"}

### 409: producto 5 sin stock
POST {{api}}/cart/quote
Content-Type: application/json

{"items": [{"productId": 5, "quantity": 1}]}

### 422: cupón vencido
POST {{api}}/cart/quote
Content-Type: application/json

{"items": [{"productId": 1, "quantity": 1}], "couponCode": "EXPIRED2025"}

### 400: productId duplicado
POST {{api}}/cart/quote
Content-Type: application/json

{"items": [{"productId": 1, "quantity": 1}, {"productId": 1, "quantity": 2}]}

### ---------- Órdenes (HU3) ----------
### 201 + Location (ORD-2026-000005)
POST {{api}}/orders
Content-Type: application/json

{"items": [{"productId": 1, "quantity": 2}, {"productId": 9, "quantity": 1}], "couponCode": "WELCOME2026"}

### 409: producto 7 solo tiene 2
POST {{api}}/orders
Content-Type: application/json

{"items": [{"productId": 7, "quantity": 3}]}

###
GET {{api}}/orders?from=2026-10-01T00:00:00&to=2026-10-31T23:59:59&page=0&size=20

###
GET {{api}}/orders?couponCode=TESTCAP30

###
GET {{api}}/orders/4

###
GET {{api}}/orders/number/ORD-2026-000003

### ---------- Actuator ----------
GET {{host}}/actuator/health

###
GET {{host}}/actuator/metrics/cart.quotes
